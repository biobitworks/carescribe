{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anticube Assessment",
  "type": "object",
  "required": [
    "assessment_id",
    "subject_fco",
    "context_fco",
    "identity",
    "safety",
    "evidence",
    "decision"
  ],
  "properties": {
    "assessment_id": {
      "type": "string"
    },
    "subject_fco": {
      "type": "string"
    },
    "context_fco": {
      "type": "string"
    },
    "identity": {
      "enum": [
        "self",
        "non-self",
        "mixed",
        "unknown"
      ]
    },
    "safety": {
      "enum": [
        "safe",
        "non-safe",
        "conditional",
        "unknown"
      ]
    },
    "identity_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "safety_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prohibited_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision": {
      "enum": [
        "admit",
        "bounded_admit",
        "reject",
        "quarantine",
        "human_required"
      ]
    },
    "reviewer": {
      "type": [
        "string",
        "null"
      ]
    },
    "signature": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}